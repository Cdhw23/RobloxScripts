local player = game.Players.LocalPlayer
local RS = game.RunService

local RANGE = 55

if getgenv().v then
    getgenv().v:Disconnect()
end

if getgenv().a then
    getgenv().a:Disconnect()
end

if getgenv().c then
    getgenv().c:Disconnect()
end

local catching = false
local tracks = {}
local animations = {}
local animationIds = {}

local catchNames = {
    Mid = true,
    High = true,
    Low = true,
    Left = true,
    Right = true
}

local function getBall(root)
    local closest
    local distance = math.huge

    for number, ball in game.Workspace:GetChildren() do
        if ball:IsA("BasePart") and (ball.Name == "Football" or ball.Name == "KBall") then
            local mag = (ball.Position - root.Position).Magnitude

            if mag < distance then
                distance = mag
                closest = ball
            end
        end
    end

    return closest, distance
end

local function getHand(character, ball)
    local right = character:FindFirstChild("RightHand")
        or character:FindFirstChild("Right Arm")

    local left = character:FindFirstChild("LeftHand")
        or character:FindFirstChild("Left Arm")

    if right and left then
        local rightDistance = (ball.Position - right.Position).Magnitude
        local leftDistance = (ball.Position - left.Position).Magnitude

        if rightDistance < leftDistance then
            return right
        else
            return left
        end
    end

    return right or left
end

local function updateCatch()
    catching = next(tracks) ~= nil
end

local function isCatch(track)
    if not track.Animation then
        return false
    end

    if animations[track.Animation] then
        return true
    end

    if animationIds[track.Animation.AnimationId] then
        return true
    end

    return false
end

local function catchTrack(track)
    if not isCatch(track) then
        return
    end

    tracks[track] = true
    updateCatch()

    local stopped

    stopped = track.Stopped:Connect(function()
        tracks[track] = nil
        updateCatch()

        if stopped then
            stopped:Disconnect()
        end
    end)
end

local function setup(character)
    animations = {}
    animationIds = {}
    tracks = {}
    catching = false

    if getgenv().a then
        getgenv().a:Disconnect()
        getgenv().a = nil
    end

    local humanoid = character:WaitForChild("Humanoid", 10)

    if not humanoid then
        return
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = humanoid:WaitForChild("Animator", 10)
    end

    if not animator then
        return
    end

    local catch = character:WaitForChild("Catch", 10)

    if not catch then
        return
    end

    local client = catch:WaitForChild("c", 10)

    if not client then
        return
    end

    for number, animation in client:GetChildren() do
        if animation:IsA("Animation") and catchNames[animation.Name] then
            animations[animation] = true

            if animation.AnimationId ~= "" then
                animationIds[animation.AnimationId] = true
            end
        end
    end

    getgenv().a = animator.AnimationPlayed:Connect(function(track)
        catchTrack(track)
    end)

    for number, track in animator:GetPlayingAnimationTracks() do
        catchTrack(track)
    end
end

if player.Character then
    task.spawn(setup, player.Character)
end

getgenv().c = player.CharacterAdded:Connect(function(character)
    task.spawn(setup, character)
end)

getgenv().v = RS.Heartbeat:Connect(function()
    if not catching then
        return
    end

    if not player.Character then
        return
    end

    if player.Character:FindFirstChild("Football") then
        return
    end

    local root = player.Character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    local ball, distance = getBall(root)

    if not ball then
        return
    end

    if distance > RANGE then
        return
    end

    if isnetworkowner and not isnetworkowner(ball) then
        return
    end

    local hand = getHand(player.Character, ball)

    if not hand then
        return
    end

    if firetouchinterest then
        firetouchinterest(hand, ball, 0)
        firetouchinterest(hand, ball, 1)
    end

    ball.AssemblyLinearVelocity = Vector3.zero
    ball.AssemblyAngularVelocity = Vector3.zero

    ball.CFrame = hand.CFrame
end)
